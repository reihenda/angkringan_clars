# Neon Postgres. Di Vercel kedua nilai ini otomatis terisi oleh integrasi Neon.
# Lokal: salin dari Neon (Connection details). DATABASE_URL boleh pooled,
# DATABASE_URL_UNPOOLED harus koneksi langsung (host tanpa "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Isi string acak panjang: openssl rand -base64 32
SESSION_SECRET="isi-string-acak-minimal-32-karakter"
